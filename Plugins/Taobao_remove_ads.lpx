#!name = 淘宝去广告 增强版 v10.1
#!desc = fork 自 kelee 2026-10-02 版，多轮冷启动 HAR 实证迭代。拦截开屏广告、首页弹窗/浮层/运营 banner 与埋点域族（mmstat/tanx/amap 等）；修复原版 poplayer 弹层配置正则失配。v10 试验结论（2026-10-09 实机证伪）：IP 层打断 amdc 存量直连不可行——拦 210.4 换 215.15、拦 9.249 换 33.214（IP 池轮换打地鼠），且直连呈上行 434KB/下行 236B 重试形态白烧流量；核心 feed/detail 走无 SNI 的 ANet 私有多路复用通道（sni-sniffing 开启仍显示裸 IP），MITM 无从挂载，已回退全部 IP 规则，维持 v9 能力（amdc 域名/裸 IP 调度静默回落 + 域名通道广告拦截）。更新插件后请核对 name 中的版本号。
#!author = RuCu6/可莉（原版规则） / 个人增强 fork
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Taobao.png
#!date = 2026-10-08
#!loon_version = 3.5.1(998)

[Rule]
DOMAIN, adashx.m.taobao.com, REJECT
DOMAIN, ossgw.alicdn.com, REJECT
DOMAIN, ems.youku.com, REJECT
DOMAIN, hudong.alicdn.com, REJECT
DOMAIN, h-adashx.ut.taobao.com, REJECT
DOMAIN, ut.taobao.com, REJECT
DOMAIN, cdn.ynuf.aliapp.org, REJECT
DOMAIN, tiga-release-dc.m.taobao.com, REJECT
DOMAIN, loggw-ex.alipay.com, REJECT
DOMAIN, dualstack-logs.amap.com, REJECT
DOMAIN-SUFFIX, logs.amap.com, REJECT
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, mmstat.com, REJECT
DOMAIN, mdap.alipay.com, REJECT
DOMAIN, app-monitor.ele.me, REJECT
DOMAIN, alsc-fingerprint.ele.me, REJECT
DOMAIN-SUFFIX, cloudvideocdn.taobao.com, REJECT
AND, ((DOMAIN-SUFFIX, m.taobao.com), (PROTOCOL, QUIC)), REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/poplayer\.template\.alibaba\.com\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/tb\.ele\.me\/app\/conch-page\/eat-coupon-center\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/tb\.ele\.me\/app\/TBTakeout\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/gw\.alipayobjects\.com\/config\/loggw\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/g\.alicdn\.com\/TBTakeout\/et-home\//i then reject_dict(200)

[Script]
response if ${url} ~= /^http:\/\/[^\/]+(:\d+)?\/amdc\/mobileDispatch/ then script("https://raw.githubusercontent.com/songsongisme/Loon-config/main/Scripts/amdc_fallback.js") with tag="淘宝amdc静默回落", requires_body=true
response if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)/i then script("https://kelee.one/Resource/JavaScript/Taobao/Taobao_remove_ads.js") with tag="移除淘宝开屏广告", requires_body=true

[MitM]
hostname = acs.m.taobao.com, heic.alicdn.com, gw.alicdn.com, guide-acs.m.taobao.com, poplayer.template.alibaba.com, tb.ele.me, gw.alipayobjects.com, infinite.m.taobao.com
