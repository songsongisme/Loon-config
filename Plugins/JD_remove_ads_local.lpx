#!name = 京东去广告（本地增强版）
#!desc = 移除京东开屏广告，精简首页/我的页面产品推广。kelee 原版（2026-10-02）完整 fork，本地增补 1 处：welcomeHome 响应中移除全部 type=hybrid 运营楼层（实测 7 个 hybrid 全为推广物料：国家补贴/品质生活/9.9包邮/直播/官方直降banner/延迟弹窗/高潜省钱卡，无功能件），整类过滤抗大促轮换；上游更新时 diff 本插件与 kelee_originals/JD_remove_ads.lpx。脚本以 GitHub raw 分发（本仓库 Scripts/JD_remove_ads_local.js），更新脚本后 push 即生效，设备端"更新插件"拉取。另：uniformRecommend9 为首页推荐主 feed，有意不拦截（kelee 的 uniformRecommend[06] 规则勿扩大到 9）。注意：[Rewrite]/[Script] 段内行尾不能带分号、不能有 # 注释，否则整段不识别。
#!author = RuCu6/Maasea（原版规则） / 本地 fork 增补
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!date = 2026-10-08
#!loon_version = 3.5.1(998)

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig/i then response.json.replace(["data.JDMessage.socketmonitor.isSocketEstablishedAhead", "data.JDMessage.socketmonitor.isSocketReport", "data.JDHttpToolKit.httpdns.httpdns"], [0, 0, 0])

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)/i then script("https://raw.githubusercontent.com/songsongisme/Loon-config/main/Scripts/JD_remove_ads_local.js") with tag="移除京东广告(本地增强)", requires_body=true

[MitM]
hostname=api.m.jd.com
